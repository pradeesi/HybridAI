# Purpose: Template of required environment configuration variables for HybridAI.
# Architecture/Context: Consumed by application runtime configuration loaders.
# Dependencies/Side Effects: Keep actual credentials in .env (which is gitignored).

# Application Configuration
APP_ENV=development
PORT=8080
LOG_LEVEL=INFO

# External Services / APIs
# Add your service keys here (never commit real credentials)
# GITHUB_TOKEN=
