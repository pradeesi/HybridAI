# Purpose: Template of required environment configuration variables for Telecom HybridAI.
# Architecture/Context: Consumed by Docker Compose and local application processes.
# Dependencies/Side Effects: Copy to .env and fill in secure passwords; .env is gitignored.

# Environment & Server
APP_ENV=development
LOG_LEVEL=INFO
CRM_PORT=8000
MCP_PORT=8001

# Security & Authentication (Required for Gemini Enterprise App)
MCP_AUTH_TOKEN=telecom-mcp-secret-token-change-in-prod-xyz987

# PostgreSQL Credentials
POSTGRES_USER=telecom_user
POSTGRES_PASSWORD=telecom_secure_pass
POSTGRES_DB=telecom_db
DATABASE_URL=postgresql+asyncpg://telecom_user:telecom_secure_pass@localhost:5432/telecom_db

# Observability Configuration
LOKI_URL=http://localhost:3100
PROMETHEUS_PORT=9090
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=telecom_admin
