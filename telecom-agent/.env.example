# Google Cloud Vertex AI Configuration
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
MODEL_NAME=gemini-2.5-flash

# FastMCP Server Connection Configuration
# For live Cloud Run deployment: https://telecom-mcp-server-1111937452.europe-west1.run.app
# For local dev / gateway: http://localhost:8001
# For On-Prem Proxmox server: http://<proxmox-ip-or-host>:8001
MCP_SERVER_URL=https://telecom-mcp-server-1111937452.europe-west1.run.app
MCP_DEPLOYMENT_TARGET=cloud_run

# On-Prem Proxmox Static Authentication Token
# Required when MCP_DEPLOYMENT_TARGET is 'on_prem'
MCP_AUTH_TOKEN=telecom-mcp-secret-token-change-in-prod-xyz987
